<Window
    x:Class="GoodBad_Conveyor_2._0.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GoodBad_Conveyor_2._0"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="MainView"
    Title="SMART CONVEYOR"
    Width="1344"
    Height="894"
    AllowsTransparency="True"
    Background="Transparent"
    BorderBrush="Transparent"
    BorderThickness="0"
    Closing="Window_Closing"
    ResizeMode="NoResize"
    Topmost="true"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Height" Value="30" />
            <!--<Setter Property="HorizontalContentAlignment" Value="Center" />-->
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Height" Value="25" />
            <!--<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch" />-->
        </Style>

        <Style x:Key="RoundLabel" TargetType="{x:Type Label}">
            <Style.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10" />
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="RoundLabelTop" TargetType="{x:Type Label}">
            <Style.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="0,0,7,7" />
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="RoundDock" TargetType="{x:Type DockPanel}">
            <Style.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10" />
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="RoundButton" TargetType="{x:Type Button}">
            <Style.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="7" />
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Border
        Margin="0,0,0,0"
        BorderBrush="White"
        BorderThickness="7"
        CornerRadius="10">
        <Grid
            Margin="0,0,0,0"
            Background="White"
            MouseDown="Grid_MouseDown">

            <!--<Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            </Grid.RowDefinitions>-->

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>






            <Label
                x:Name="lblLane2"
                Width="1260"
                Height="176"
                Margin="31,474,0,214"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#424242"
                Content="LANE 2"
                FontSize="27"
                FontWeight="Bold"
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundLabel}" />

            <Label
                x:Name="lblLane2IO"
                Width="168"
                Height="126"
                Margin="0,498,54,240"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#424242"
                Content=""
                FontSize="16"
                FontWeight="Normal"
                Foreground="WhiteSmoke"
                MouseDoubleClick="lblLane2IO_MouseDoubleClick"
                Style="{DynamicResource RoundLabel}" />


            <Label
                x:Name="lblLane1"
                Width="1261"
                Height="174"
                Margin="30,80,0,610"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#424242"
                Content="LANE 1"
                FontSize="27"
                FontWeight="Bold"
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundLabel}" />


            <Label
                x:Name="lblLane1IO"
                Width="170"
                Height="128"
                Margin="0,104,54,632"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#424242"
                Content=""
                FontSize="16"
                FontWeight="Normal"
                Foreground="WhiteSmoke"
                MouseDoubleClick="lblLane1IO_MouseDoubleClick"
                Style="{DynamicResource RoundLabel}" />


            <Label
                x:Name="lblEventosLane2"
                Width="170"
                Height="32"
                Margin="31,656,1123,176"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#263250"
                Content="Events LANE 2:"
                FontSize="14"
                FontWeight="Normal"
                Foreground="White"
                Style="{DynamicResource RoundLabel}" />

            <DataGrid
                x:Name="DgLane2"
                Width="1085"
                Height="192"
                Margin="206,656,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                LoadingRow="DgLane2_LoadingRow" />

            <StackPanel>
                <Label
                    x:Name="lblEventosLane1"
                    Width="170"
                    Height="31"
                    Margin="31,265,1123,568"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#263250"
                    Content="Events LANE 1:"
                    FontSize="14"
                    FontWeight="Normal"
                    Foreground="White"
                    Style="{DynamicResource RoundLabel}" />
            </StackPanel>


            <DataGrid
                x:Name="DgLane1"
                Width="1085"
                Height="190"
                Margin="206,265,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                LoadingRow="DgLane1_LoadingRow" />

            <Label
                x:Name="lblTitle"
                Width="861"
                Height="70"
                Margin="206,3,263,807"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#263250"
                Content="HLC GOOD BAD CONVEYOR"
                FontSize="21"
                FontWeight="Bold"
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundLabel}" />

            <Button
                x:Name="btnExit"
                Width="46"
                Height="25"
                Margin="0,-8,-8,863"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="#D50000"
                BorderBrush="Transparent"
                Click="btnExit_Click"
                Content="X"
                FontSize="14"
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundExitButton}" />

            <Button
                x:Name="btnMinimize"
                Width="46"
                Height="23"
                Margin="0,-7,37,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="White"
                BorderBrush="Transparent"
                Click="btnMinimize_Click"
                Content="_"
                FontSize="14" />

            <Label
                x:Name="lblVersion"
                Width="148"
                Height="31"
                Margin="1093,-7,89,856"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#263250"
                Content="v1.0.0.0"
                FontSize="14"
                FontWeight="Normal"
                Foreground="White"
                Style="{DynamicResource RoundLabelTop}" />

            <Label
                x:Name="lblLane1Disable"
                Width="0"
                Height="380"
                Margin="26,77,28,407"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#BDBDBD"
                Content="LANE 1 DISABLE"
                FontSize="27"
                FontWeight="Bold"
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundLabel}" />

            <Label
                x:Name="lblLane2Disable"
                Width="0"
                Height="380"
                Margin="26,468,28,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#BDBDBD"
                Content="LANE 2 DISABLE"
                FontSize="27"
                FontWeight="Bold"
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundLabel}" />

            <Label
                x:Name="DockMenu"
                Height="881"
                Margin="-1,-1,1146,0"
                VerticalAlignment="Top"
                Background="#263238"
                Content=""
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundLabel}" />


            <Button
                x:Name="btnMenu"
                Margin="9,8,0,842"
                Click="btnMenu_Click"
                Style="{StaticResource TopButton}">
                <Icon:PackIconMaterial
                    Width="15"
                    Height="15"
                    Kind="MenuOpen" />
            </Button>


            <!--<Button x:Name="btnMenu"
            Style="{DynamicResource RoundButton}"
            Content="M"
            FontSize="14"
            Foreground="WhiteSmoke"
            BorderThickness=".5"
            BorderBrush="Transparent"
            Background="#455A64"
            HorizontalAlignment="Left"
            Margin="6,5,0,824"
            VerticalAlignment="Center"
            Width="45"
            Height="45"
            Click="btnMenu_Click"/>-->

            <Button
                x:Name="btnOnOff_Lane1"
                Width="120"
                Height="35"
                Margin="29,65,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#455A64"
                BorderBrush="Transparent"
                BorderThickness=".5"
                Click="btnOnOff_Lane1_Click"
                Content="LANE 1"
                FontSize="14"
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundButton}" />

            <Button
                x:Name="btnOnOff_Lane2"
                Width="120"
                Height="34"
                Margin="29,118,0,728"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#455A64"
                BorderBrush="Transparent"
                BorderThickness=".5"
                Click="btnOnOff_Lane2_Click"
                Content="LANE 2"
                FontSize="14"
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundButton}" />

            <Button
                x:Name="btnDebug"
                Width="120"
                Height="34"
                Margin="29,170,0,676"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#455A64"
                BorderBrush="Transparent"
                BorderThickness=".5"
                Click="btnDebug_Click"
                Content="DEBUG"
                FontSize="14"
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundButton}" />

            <Button
                x:Name="btnPassThru"
                Width="120"
                Height="36"
                Margin="29,821,0,23"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#00897B"
                BorderBrush="Transparent"
                BorderThickness=".5"
                Click="btnPassThru_Click"
                Content="PASS THRU"
                FontSize="14"
                Foreground="WhiteSmoke"
                Style="{DynamicResource RoundButton}" />

            <Ellipse
                Width="Auto"
                Height="Auto"
                Margin="477,31,835,830">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="Resources/FlagGreen_40967.ico" />
                </Ellipse.Fill>

            </Ellipse>
        </Grid>
    </Border>
</Window>

